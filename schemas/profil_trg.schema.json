{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glori.unhas.ac.id/schemas/profil_trg.schema.json",
  "title": "Profil TRG (isian berkelanjutan)",
  "description": "Satu pengiriman = profil lengkap satu TRG. Pengiriman terbaru menggantikan yang lama; riwayat disimpan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versi",
    "trg_slug",
    "dikirim_pada",
    "dikirim_oleh",
    "anggota"
  ],
  "properties": {
    "versi": {
      "const": 2
    },
    "trg_slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "dikirim_pada": {
      "type": "string",
      "format": "date-time"
    },
    "dikirim_oleh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nama"
      ],
      "properties": {
        "nama": {
          "type": "string",
          "minLength": 2
        },
        "akun": {
          "type": "string",
          "description": "ID akun portal, bukan email"
        }
      }
    },
    "anggota": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nama"
        ],
        "properties": {
          "nama": {
            "type": "string",
            "minLength": 2,
            "description": "Nama lengkap dengan gelar, sebagaimana ditulis di situs TRG"
          },
          "peran": {
            "enum": [
              "Leader",
              "Lecturer",
              "Researcher",
              "Member",
              "External collaborator",
              "Student"
            ]
          },
          "afiliasi": {
            "type": "string"
          },
          "keahlian_tema": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "A01",
                "A02",
                "A03",
                "A04",
                "A05",
                "A06",
                "A07",
                "A08",
                "A09",
                "A10",
                "B01",
                "B02",
                "B03",
                "B04",
                "B05",
                "B06",
                "B07",
                "B08",
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06",
                "C07",
                "C08",
                "C09",
                "C10",
                "D01",
                "D02",
                "D03",
                "D04",
                "D05",
                "D06",
                "D07",
                "D08",
                "D09",
                "D10"
              ]
            },
            "description": "Maksimal 3 kode tema Tingkat 1 (tag_tier1.csv)"
          },
          "kata_kunci": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
          },
          "sinta_id": {
            "type": "string",
            "pattern": "^\\d{3,12}$"
          },
          "scopus_id": {
            "type": "string",
            "pattern": "^\\d{6,14}$"
          },
          "status": {
            "enum": [
              "Aktif",
              "Tidak aktif lagi"
            ]
          }
        }
      }
    },
    "trg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tema": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A01",
              "A02",
              "A03",
              "A04",
              "A05",
              "A06",
              "A07",
              "A08",
              "A09",
              "A10",
              "B01",
              "B02",
              "B03",
              "B04",
              "B05",
              "B06",
              "B07",
              "B08",
              "C01",
              "C02",
              "C03",
              "C04",
              "C05",
              "C06",
              "C07",
              "C08",
              "C09",
              "C10",
              "D01",
              "D02",
              "D03",
              "D04",
              "D05",
              "D06",
              "D07",
              "D08",
              "D09",
              "D10"
            ]
          }
        },
        "kata_kunci": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "deskripsi": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "mitra": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nama"
        ],
        "properties": {
          "nama": {
            "type": "string"
          },
          "jenis": {
            "enum": [
              "Pemerintah pusat",
              "Pemerintah daerah",
              "Industri/swasta",
              "LSM/komunitas",
              "Perguruan tinggi dalam negeri",
              "Perguruan tinggi/lembaga luar negeri",
              "Lembaga riset (BRIN dll.)",
              "Rumah sakit/fasilitas kesehatan",
              "Lainnya"
            ]
          },
          "bentuk": {
            "type": "string"
          },
          "tahun_mulai": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          }
        }
      }
    },
    "riset_unggulan": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judul"
        ],
        "properties": {
          "judul": {
            "type": "string"
          },
          "tahun": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "sumber_dana": {
            "type": "string"
          },
          "mitra": {
            "type": "string"
          },
          "tkt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "luaran": {
            "enum": [
              "Artikel jurnal",
              "Buku/bab buku",
              "HKI/paten",
              "Produk/prototipe",
              "Kebijakan/rekomendasi",
              "Pelatihan/pendampingan",
              "Lainnya"
            ]
          },
          "tautan": {
            "type": "string"
          }
        }
      }
    },
    "pendanaan": {
      "type": "array",
      "maxItems": 10,
      "description": "Pendanaan riset 5 tahun terakhir; dasar penilaian kelayakan konsorsium/institut",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sumber",
          "tahun"
        ],
        "properties": {
          "sumber": {
            "type": "string",
            "description": "Pemberi dana atau skema"
          },
          "tahun": {
            "type": "integer",
            "minimum": 2015,
            "maximum": 2100
          },
          "jumlah_rupiah": {
            "type": "integer",
            "minimum": 0
          },
          "peran": {
            "enum": [
              "Ketua",
              "Anggota"
            ]
          }
        }
      }
    },
    "kesediaan_konsorsium": {
      "enum": [
        "Ya",
        "Mungkin",
        "Tidak"
      ]
    },
    "catatan": {
      "type": "string",
      "maxLength": 1000
    }
  }
}