    },
    "sumber": {
      "type": "string"
    },
    "institusi": {
      "type": "string"
    },
    "dari": {
      "type": "integer",
      "minimum": 0
    },
    "bidang_dari": {
      "type": "integer",
      "minimum": 0
    },
    "tahun": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "y",
          "semua",
          "artikel",
          "oa"
        ],
        "properties": {
          "y": {
            "type": "integer",
            "minimum": 0
