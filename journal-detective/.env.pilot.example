# Contoh lingkungan PILOT (salin ke .env.pilot atau variabel systemd). TANPA rahasia nyata di berkas ini.
# Jangan memakai berkas .env DEMO untuk pilot. Basis data & folder unggahan WAJIB terpisah dari DEMO.
APP_MODE="PILOT"
DATABASE_URL="file:./pilot.db"
STORAGE_DIR="/var/lib/journal-detective/storage-pilot"
SESSION_SECRET=""            # openssl rand -base64 48
PUBLIC_BASE_URL="https://jurnal-detective.fakultas.example"
# Hanya untuk pilot:init (hapus dari lingkungan setelah inisialisasi):
PILOT_ADMIN_EMAIL=""
PILOT_ADMIN_NAME=""
PILOT_ADMIN_PASSWORD=""
# JANGAN set: DEMO_PASSWORD, INSECURE_COOKIES, AI_EXTERNAL_ENABLED (kecuali keputusan operator terdokumentasi)
