# Salin ke .env lalu sesuaikan. JANGAN commit .env. Tanpa rahasia nyata di berkas ini.
# ===== LINGKUNGAN: DEMO (data fiktif) atau PILOT (data nyata) =====
# DEMO dan PILOT WAJIB memakai basis data dan folder unggahan TERPISAH. PILOT menolak lokasi bawaan DEMO.
APP_MODE="DEMO"
DATABASE_URL="file:./dev.db"
STORAGE_DIR="./storage"
# --- Contoh PILOT (simpan di .env.pilot, jangan dicampur dengan .env DEMO) ---
# APP_MODE="PILOT"
# DATABASE_URL="file:./pilot.db"
# STORAGE_DIR="./storage-pilot"
# PILOT_ADMIN_EMAIL=""      # hanya dipakai pilot:init; bukan domain @jd.example
# PILOT_ADMIN_NAME=""
# PILOT_ADMIN_PASSWORD=""   # >= 12 karakter; hapus dari lingkungan setelah init

# Wajib di produksi/pilot: string acak >= 32 karakter (openssl rand -base64 48)
SESSION_SECRET=""
# Basis URL publik (HTTPS pada pilot) untuk QR verifikasi surat
PUBLIC_BASE_URL="http://localhost:3000"
# Kata sandi akun demo (hanya dipakai `npm run db:seed` pada DEMO). JANGAN diset pada PILOT.
DEMO_PASSWORD="demo-journal-detective"

# --- Integrasi opsional (kosong = nonaktif, status UNAVAILABLE) ---
SCOPUS_API_KEY=""
# Layanan AI eksternal NONAKTIF kecuali operator mengaktifkan eksplisit DAN mengakui penanganan datanya.
# Hanya ringkasan temuan jurnal yang dikirim (tidak ada dokumen/identitas mahasiswa). Lihat docs/PILOT_RUNBOOK.md.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
AI_EXTERNAL_ENABLED=""
AI_DATA_HANDLING_ACK=""
# "1" mematikan panggilan jaringan ke Crossref/DOAJ
DISABLE_EXTERNAL_LOOKUPS=""
# Hanya untuk uji lokal tanpa HTTPS. JANGAN dipakai pada pilot.
# INSECURE_COOKIES="1"
