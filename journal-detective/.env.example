# Salin ke .env lalu sesuaikan. JANGAN commit .env.
DATABASE_URL="file:./dev.db"
# Wajib di produksi: string acak >= 32 karakter (openssl rand -base64 48)
SESSION_SECRET=""
# Folder penyimpanan dokumen mahasiswa (di luar webroot)
STORAGE_DIR="./storage"
# Basis URL publik untuk QR verifikasi surat
PUBLIC_BASE_URL="http://localhost:3000"
# Kata sandi akun demo (hanya dipakai oleh `npm run db:seed`)
DEMO_PASSWORD="demo-journal-detective"
# --- Opsional: integrasi berlisensi / AI (kosong = nonaktif, status UNAVAILABLE) ---
SCOPUS_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
# Set "1" untuk mematikan panggilan jaringan ke Crossref/DOAJ
DISABLE_EXTERNAL_LOOKUPS=""
